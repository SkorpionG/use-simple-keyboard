{
  "name": "use-simple-keyboard",
  "version": "0.0.1",
  "description": "React hooks for handling keyboard inputs and hotkeys across different platforms",
  "license": "MIT",
  "author": "SkorpionG",
  "homepage": "https://github.com/SkorpionG/use-simple-keyboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkorpionG/use-simple-keyboard.git"
  },
  "bugs": {
    "url": "https://github.com/SkorpionG/use-simple-keyboard/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "typecheck:all": "npm run typecheck && npm --prefix demos run typecheck",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:coverage": "jest --config jest.config.ts --coverage",
    "test:coverage:text": "jest --config jest.config.ts --coverage --coverageReporters='text'",
    "lint": "eslint .",
    "lint:all": "npm run lint && npm --prefix demos run lint",
    "lint:fix": "eslint . --fix",
    "lint:fix:all": "npm run lint:fix && npm --prefix demos run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:all": "npm run format && npm --prefix demos run format",
    "format:check:all": "npm run format:check && npm --prefix demos run format:check",
    "prepublishOnly": "npm run format && npm run typecheck && npm run lint && npm run test && npm run build",
    "prepare": "husky",
    "husky:chmod": "chmod +x .husky/pre-commit"
  },
  "keywords": [
    "react",
    "hooks",
    "keyboard",
    "hotkeys",
    "shortcuts",
    "input"
  ],
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "overrides": {
    "eslint": "$eslint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jiti": "^2.7.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
